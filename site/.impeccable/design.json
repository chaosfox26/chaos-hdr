{
  "name": "Chaos HDR website",
  "source": "site/style.css",
  "colors": {
    "background": "#07070b",
    "surface": "#12121a",
    "text": "#f7f5fc",
    "secondary": "#bdb7cf",
    "magenta": "#ff65d0",
    "blue": "#71ceff",
    "line": "#302c3c"
  },
  "typography": {
    "display": "Audiowide",
