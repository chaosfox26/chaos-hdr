#version 450
layout(local_size_x=16,local_size_y=16) in;
layout(binding=0) uniform sampler2D source;
layout(rgba8ui,binding=1) writeonly uniform uimage2D destination;
layout(push_constant) uniform Settings { uint width,height;float intensity,grain; } config;
shared vec3 tile[324];
void main(){
    uvec2 pos=gl_GlobalInvocationID.xy;
    if(config.intensity>0){
        for(uint i=gl_LocalInvocationIndex;i<324;i+=256){
            ivec2 p=ivec2(gl_WorkGroupID.xy*16)+ivec2(i%18,i/18)-ivec2(1);
            p=clamp(p,ivec2(0),ivec2(config.width,config.height)-ivec2(1));
            tile[i]=texelFetch(source,p,0).rgb;
        }
        barrier();
    }
    if(pos.x>=config.width||pos.y>=config.height)return;
    vec3 rgb=config.intensity>0?tile[(gl_LocalInvocationID.y+1)*18+gl_LocalInvocationID.x+1]:texelFetch(source,ivec2(pos),0).rgb;
    if(config.intensity>0){
        vec3 sum=vec3(0);float count=0;
        for(int y=-1;y<=1;++y)for(int x=-1;x<=1;++x){
            ivec2 p=ivec2(pos)+ivec2(x,y);
            if(p.x>=0&&p.y>=0&&p.x<int(config.width)&&p.y<int(config.height)){
                ivec2 local=ivec2(gl_LocalInvocationID.xy)+ivec2(x,y)+ivec2(1);
                sum+=tile[local.y*18+local.x];count+=1;
            }
        }
        vec3 detail=rgb-sum/count;
        detail=sign(detail)*max(abs(detail)-config.grain*(8.0/255.0),vec3(0));
        rgb=clamp(rgb+clamp(detail,vec3(-0.05),vec3(0.05))*config.intensity,vec3(0),vec3(1));
    }
    uint packed=packUnorm4x8(vec4(rgb,1));
    imageStore(destination,ivec2(pos),uvec4(packed&255,(packed>>8)&255,(packed>>16)&255,packed>>24));
}
